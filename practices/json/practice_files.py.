def run_tests():
    print("=" * 60)
    print("ПРАКТИКА: РАБОТА С ФАЙЛАМИ")
    print("=" * 60)
    print()

    passed = 0
    failed = 0
    errors = 0

    for name, test_function, expected in TESTS:
        try:
            result = test_function()

            if result == expected:
                print(f"[OK]    {name}")
                passed += 1
            else:
                print(f"[FAIL]  {name}")
                print(f"        Ожидали: {expected!r}")
                print(f"        Получили: {result!r}")
                failed += 1

        except Exception as error:
            print(f"[ERROR] {name}")
            print(f"        {type(error).__name__}: {error}")
            errors += 1

    print()
    print("=" * 60)
    print("ИТОГ:")
    print(f"Успешно: {passed}")
    print(f"Неверный результат: {failed}")
    print(f"Ошибки выполнения: {errors}")
    print("=" * 60)

    if passed == len(TESTS):
        print("Все задания выполнены верно.")
    else:
        print("Исправьте функции выше и запустите файл снова.")


if __name__ == "__main__":
    run_tests()
