"""
Есть несколько способов прочитать содержимое файла.

1. Метод read() — читает ВЕСЬ файл сразу в одну большую строку.

    file = open("save.txt", "r", encoding="utf-8")
    content = file.read()
    print(content)
    file.close()

2. Метод readline() — читает ОДНУ строку за раз.
   Каждый следующий вызов readline() возвращает следующую строку.

    file = open("save.txt", "r", encoding="utf-8")
    first_line = file.readline()
    second_line = file.readline()
    file.close()

3. Метод readlines() — читает весь файл и возвращает СПИСОК строк.

    file = open("save.txt", "r", encoding="utf-8")
    lines = file.readlines()
    # lines — это список: ["строка 1\n", "строка 2\n", ...]
    file.close()

4. Итерация по файлу — самый удобный способ для больших файлов.
   Файл можно перебирать в цикле for, как список.

    file = open("save.txt", "r", encoding="utf-8")
    for line in file:
        print(line.strip())  # strip() убирает символ \n в конце
    file.close()

ВАЖНО: после чтения обязательно вызывайте file.close()!
Иначе файл останется открытым, и могут быть проблемы.
"""

print("=" * 60)
print("ЧАСТЬ 4. Чтение файла (демонстрация)")
print("=" * 60)

# Сначала создадим демонстрационный файл для чтения
demo_file = open("demo_read.txt", "w", encoding="utf-8")
demo_file.write("Первая строка\n")
demo_file.write("Вторая строка\n")
demo_file.write("Третья строка\n")
demo_file.close()
print("Создан файл demo_read.txt с тремя строками.")
print()

# Способ 1: read() — читает весь файл в одну строку
print("--- Способ 1: read() ---")
file = open("demo_read.txt", "r", encoding="utf-8")
content = file.read()
print("Содержимое файла:")
print(content)
file.close()
print()

# Способ 2: readline() — читает по одной строке
print("--- Способ 2: readline() ---")
file = open("demo_read.txt", "r", encoding="utf-8")
first = file.readline()
second = file.readline()
print(f"Первая строка: {first.strip()}")
print(f"Вторая строка: {second.strip()}")
file.close()
print()

# Способ 3: readlines() — возвращает список строк
print("--- Способ 3: readlines() ---")
file = open("demo_read.txt", "r", encoding="utf-8")
lines = file.readlines()
print(f"Количество строк: {len(lines)}")
print(f"Список строк: {lines}")
