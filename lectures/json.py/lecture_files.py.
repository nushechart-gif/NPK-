# --- ЗАДАЧА 1: Сохранить HP игрока ---
def save_hp(filename, hp):
    """Сохраняет здоровье игрока в текстовый файл."""
    with open(filename, "w", encoding="utf-8") as file:
        file.write(str(hp))
    print(f"HP {hp} сохранён в файл {filename}")


# --- ЗАДАЧА 2: Загрузить HP игрока ---
def load_hp(filename):
    """Загружает здоровье игрока из текстового файла."""
    with open(filename, "r", encoding="utf-8") as file:
        content = file.read()
        hp = int(content)
    print(f"HP {hp} загружен из файла {filename}")
    return hp


print("--- Сохранение и загрузка HP ---")
save_hp("player_hp.txt", 100)
loaded_hp = load_hp("player_hp.txt")
print(f"Загруженное значение: {loaded_hp}")
print()


# --- ЗАДАЧА 3: Сохранить инвентарь ---
def save_inventory(filename, inventory):
    """
    Сохраняет список предметов в файл.
    Каждый предмет — на отдельной строке.
    """
    with open(filename, "w", encoding="utf-8") as file:
        for item in inventory:
            file.write(item + "\n")
    print(f"Инвентарь сохранён в файл {filename}")


# --- ЗАДАЧА 4: Загрузить инвентарь ---
def load_inventory(filename):
    """
    Загружает список предметов из файла.
    Каждая строка файла — один предмет.
    """
    inventory = []
    with open(filename, "r", encoding="utf-8") as file:
        for line in file:
            item = line.strip()  # убираем \n и пробелы по краям
            if item:  # пропускаем пустые строки
                inventory.append(item)
    print(f"Инвентарь загружен из файла {filename}")
    return inventory


print("--- Сохранение и загрузка инвентаря ---")
my_inventory = ["меч", "зелье", "щит", "ключ"]
save_inventory("inventory.txt", my_inventory)
loaded_inventory = load_inventory("inventory.txt")
print(f"Загруженный инвентарь: {loaded_inventory}")
print()


