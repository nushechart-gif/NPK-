# ЧАСТЬ 6. КОНСТРУКЦИЯ with (МЕНЕДЖЕР КОНТЕКСТА)
# =================================================================
"""
В предыдущих примерах мы каждый раз писали:
    file = open(...)
    ...
    file.close()

Это неудобно и опасно: если между open() и close() произойдёт
ошибка, файл останется открытым навсегда.

Поэтому в Python есть специальная конструкция with, которая
АВТОМАТИЧЕСКИ закрывает файл, даже если внутри произошла ошибка.

Было:
    file = open("save.txt", "r", encoding="utf-8")
    content = file.read()
    file.close()

Стало:
    with open("save.txt", "r", encoding="utf-8") as file:
        content = file.read()
    # Здесь файл уже закрыт автоматически!

Как это работает:
1. with открывает файл и присваивает его переменной file
2. Выполняется код внутри блока with (с отступом)
3. Как только Python выходит из блока with (даже по ошибке),
   файл автоматически закрывается

Это СОВРЕМЕННЫЙ и ПРАВИЛЬНЫЙ способ работы с файлами в Python.
Используйте with всегда.
"""

print("=" * 60)
print("ЧАСТЬ 6. Конструкция with")
print("=" * 60)

print("--- Чтение через with ---")
with open("demo_read.txt", "r", encoding="utf-8") as file:
    content = file.read()
print(f"Содержимое: {content.strip()}")
print("Файл закрыт автоматически после выхода из with.")
print()

print("--- Запись через with ---")
with open("demo_with.txt", "w", encoding="utf-8") as file:
    file.write("Записано через with\n")
    file.write("Файл закроется сам\n")
print("Файл demo_with.txt создан и закрыт автоматически.")
print()


